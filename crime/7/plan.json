 ],
 "subs": [
  {
   "s": 0.22,
   "e": 1.895,
   "text": "Ein arbeitsloser Schuhmacher kauft",
   "line": 1
  },
  {
   "s": 1.895,
   "e": 3.509,
   "text": "sich eine alte Uniform.",
   "line": 1
  },
  {
   "s": 3.509,
   "e": 5.109,
   "text": "Wenige Stunden später gehorchen",
   "line": 2
  },
  {
   "s": 5.109,
   "e": 6.909,
   "text": "ihm Soldaten, ein Bürgermeister",
   "line": 2
  },
  {
   "s": 6.909,
   "e": 8.396,
   "text": "und eine ganze Stadt.",
   "line": 2
  },
  {
   "s": 8.396,
   "e": 10.399,
   "text": "Das ist der Hauptmann von Köpenick.",
   "line": 3
  },
  {
   "s": 10.399,
   "e": 13.019,
   "text": "Berlin, 1906. Wilhelm Voigt ist",
   "line": 4
  },
  {
   "s": 13.019,
   "e": 15.219,
   "text": "57 Jahre alt und hat viele",
   "line": 4
  },
  {
   "s": 15.219,
   "e": 16.982,
   "text": "Jahre im Gefängnis verbracht.",
   "line": 4
  },
  {
   "s": 16.982,
   "e": 19.082,
   "text": "Ohne Papiere bekommt er keine Arbeit.",
   "line": 5
  },
  {
   "s": 19.082,
   "e": 21.119,
   "text": "Ohne Arbeit bekommt er keine Papiere.",
   "line": 5
  },
  {
   "s": 21.119,
   "e": 22.219,
   "text": "Doch im Kaiserreich gilt",
   "line": 6
  },
  {
   "s": 22.219,
   "e": 24.658,
   "text": "eine Uniform mehr als jedes Dokument.",
   "line": 6
  },
  {
   "s": 24.658,
   "e": 26.098,
   "text": "Bei Trödlern kauft sich Voigt",
   "line": 7
  },
  {
   "s": 26.098,
   "e": 28.032,
   "text": "die Uniform eines Hauptmanns.",
   "line": 7
  },
  {
   "s": 28.032,
   "e": 30.412,
   "text": "Am 16. Oktober 1906 hält er auf",
   "line": 8
  },
  {
   "s": 30.412,
   "e": 32.721,
   "text": "der Straße einen Trupp Soldaten an.",
   "line": 8
  },
  {
   "s": 32.721,
   "e": 33.621,
   "text": "Er befiehlt ihnen,",
   "line": 9
  },
  {
   "s": 33.621,
   "e": 35.434,
   "text": "ihm zu folgen. Und sie folgen.",
   "line": 9
  },
  {
   "s": 35.434,
   "e": 37.254,
   "text": "Mit der Bahn fahren sie nach Köpenick,",
   "line": 10
  },
  {
   "s": 37.254,
   "e": 39.413,
   "text": "damals eine eigene Stadt vor Berlin.",
   "line": 10
  },
  {
   "s": 39.413,
   "e": 41.153,
   "text": "Voigt lässt das Rathaus besetzen.",
   "line": 11
  },
  {
   "s": 41.153,
   "e": 43.169,
   "text": "Niemand darf hinein oder hinaus.",
   "line": 11
  },
  {
   "s": 43.169,
   "e": 44.389,
   "text": "Dann lässt er den Bürgermeister",
   "line": 12
  },
  {
   "s": 44.389,
   "e": 45.505,
   "text": "festnehmen.",
   "line": 12
  },
  {
   "s": 45.505,
   "e": 47.125,
   "text": "Und er verlangt die Stadtkasse.",
   "line": 13
  },
  {
   "s": 47.125,
   "e": 47.985,
   "text": "Mehrere tausend",
   "line": 13
  },
  {
   "s": 47.985,
   "e": 49.623,
   "text": "Mark wechseln den Besitzer.",
   "line": 13
  },
  {
   "s": 49.623,
   "e": 50.883,
   "text": "Den Bürgermeister schickt",
   "line": 14
  },
  {
   "s": 50.883,
   "e": 52.67,
   "text": "er unter Bewachung nach Berlin.",
   "line": 14
  },
  {
   "s": 52.67,
   "e": 53.31,
   "text": "Dann verschwindet",
   "line": 15
  },
  {
   "s": 53.31,
   "e": 55.137,
   "text": "der Hauptmann. Einfach so.",
   "line": 15
  },
  {
   "s": 55.137,
   "e": 56.017,
   "text": "Ganz Deutschland lacht,",
   "line": 16
  },
  {
   "s": 56.017,
   "e": 57.94,
   "text": "und die halbe Welt lacht mit.",
   "line": 16
  },
  {
   "s": 57.94,
   "e": 59.8,
   "text": "Ein falscher Offizier hat gezeigt,",
   "line": 17
  },
  {
   "s": 59.8,
   "e": 61.968,
   "text": "wie blind man einer Uniform gehorcht.",
   "line": 17
  },
  {
   "s": 61.968,
   "e": 62.788,
   "text": "Zehn Tage später",
   "line": 18
  },
  {
   "s": 62.788,
   "e": 64.588,
   "text": "wird Voigt gefasst. Ein früherer",
   "line": 18
  },
  {
   "s": 64.588,
   "e": 66.482,
   "text": "Mithäftling hatte ihn verraten.",
   "line": 18
  },
  {
   "s": 66.482,
   "e": 67.202,
   "text": "Er wird zu vier Jahren",
   "line": 19
  },
  {
   "s": 67.202,
   "e": 68.683,
   "text": "Gefängnis verurteilt.",
   "line": 19
  },
  {
   "s": 68.683,
   "e": 70.529,
   "text": "Doch nach rund 20 Monaten begnadigt",
   "line": 20
  },
  {
   "s": 70.529,
   "e": 72.619,
   "text": "ihn Kaiser Wilhelm der Zweite.",
   "line": 20
  },
  {
   "s": 72.619,
   "e": 73.829,
   "text": "Voigt wird berühmt.",
   "line": 21
  },
  {
   "s": 73.829,
   "e": 75.535,
   "text": "Er verkauft Postkarten mit seinem Bild",
   "line": 21
  },
  {
   "s": 75.535,
   "e": 77.606,
   "text": "und tritt auf Jahrmärkten auf.",
   "line": 21
  },
  {
   "s": 77.606,
   "e": 78.492,
   "text": "Seine Geschichte wird",
   "line": 22
  },
  {
   "s": 78.492,
   "e": 80.647,
   "text": "zum Theaterstück und zu Filmen.",
   "line": 22
  },
  {
   "s": 80.647,
   "e": 82.074,
   "text": "Das Wort Köpenickiade steht",
   "line": 23
  },
  {
   "s": 82.074,
   "e": 83.524,
   "text": "bis heute für einen dreisten",
   "line": 23
  },
  {
   "s": 83.524,
   "e": 85.324,
   "text": "Streich mit falscher Uniform.",
   "line": 23
  },
  {
   "s": 85.324,
   "e": 86.784,
   "text": "Und vor dem Rathaus Köpenick",
   "line": 24
  },
  {
   "s": 86.784,
   "e": 88.368,
   "text": "steht heute seine Statue.",
   "line": 24
  },
  {
   "s": 88.368,
   "e": 89.208,
   "text": "Würdest du einer Uniform",
   "line": 25
  },
  {
   "s": 89.208,
   "e": 90.348,
   "text": "blind gehorchen?",
   "line": 25
  },
  {
   "s": 90.348,
   "e": 92.495,
   "text": "Schreib es in die Kommentare.",
   "line": 25
  }
 ],
