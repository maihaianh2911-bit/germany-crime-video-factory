 "subs": [
  {
   "s": 0.22,
   "e": 2.84,
   "text": "Dresden, 25. November 2019,",
   "line": 1
  },
  {
   "s": 2.84,
   "e": 5.126,
   "text": "kurz vor fünf Uhr morgens.",
   "line": 1
  },
  {
   "s": 5.126,
   "e": 5.666,
   "text": "In der Altstadt",
   "line": 2
  },
  {
   "s": 5.666,
   "e": 7.502,
   "text": "geht plötzlich das Licht aus.",
   "line": 2
  },
  {
   "s": 7.502,
   "e": 8.884,
   "text": "Minuten später fehlen im Grünen",
   "line": 3
  },
  {
   "s": 8.884,
   "e": 9.955,
   "text": "Gewölbe Juwelen im Wert",
   "line": 3
  },
  {
   "s": 9.955,
   "e": 12.156,
   "text": "von über hundert Millionen Euro.",
   "line": 3
  },
  {
   "s": 12.156,
   "e": 13.636,
   "text": "Das ist einer der spektakulärsten",
   "line": 4
  },
  {
   "s": 13.636,
   "e": 15.583,
   "text": "Museumseinbrüche Deutschlands.",
   "line": 4
  },
  {
   "s": 15.583,
   "e": 17.383,
   "text": "Das Grüne Gewölbe im Residenzschloss",
   "line": 5
  },
  {
   "s": 17.383,
   "e": 18.263,
   "text": "ist eine der großen",
   "line": 5
  },
  {
   "s": 18.263,
   "e": 20.024,
   "text": "Schatzkammern Europas.",
   "line": 5
  },
  {
   "s": 20.024,
   "e": 20.69,
   "text": "Die Täter hatten",
   "line": 6
  },
  {
   "s": 20.69,
   "e": 22.581,
   "text": "einen Stromverteiler angezündet.",
   "line": 6
  },
  {
   "s": 22.581,
   "e": 24.636,
   "text": "Die Straßenlaternen gingen aus.",
   "line": 6
  },
  {
   "s": 24.636,
   "e": 25.576,
   "text": "Dann stiegen sie durch",
   "line": 7
  },
  {
   "s": 25.576,
   "e": 27.536,
   "text": "ein Fenster ein. Das Gitter davor",
   "line": 7
  },
  {
   "s": 27.536,
   "e": 29.333,
   "text": "war vorher durchtrennt worden.",
   "line": 7
  },
  {
   "s": 29.333,
   "e": 30.673,
   "text": "Mit einer Axt schlugen sie auf",
   "line": 8
  },
  {
   "s": 30.673,
   "e": 31.813,
   "text": "eine Vitrine ein,",
   "line": 8
  },
  {
   "s": 31.813,
   "e": 33.526,
   "text": "bis das Sicherheitsglas nachgab.",
   "line": 8
  },
  {
   "s": 33.526,
   "e": 35.066,
   "text": "Eine Kamera filmte alles.",
   "line": 9
  },
  {
   "s": 35.066,
   "e": 36.585,
   "text": "Doch nach wenigen Minuten waren",
   "line": 9
  },
  {
   "s": 36.585,
   "e": 38.064,
   "text": "die Täter wieder draußen.",
   "line": 9
  },
  {
   "s": 38.064,
   "e": 39.044,
   "text": "In einer Tiefgarage",
   "line": 10
  },
  {
   "s": 39.044,
   "e": 40.424,
   "text": "zündeten sie ihr Fluchtauto",
   "line": 10
  },
  {
   "s": 40.424,
   "e": 41.918,
   "text": "an und verschwanden.",
   "line": 10
  },
  {
   "s": 41.918,
   "e": 43.498,
   "text": "Gestohlen wurden Schmuckstücke",
   "line": 11
  },
  {
   "s": 43.498,
   "e": 45.181,
   "text": "mit Tausenden Diamanten.",
   "line": 11
  },
  {
   "s": 45.181,
   "e": 46.501,
   "text": "Ein Jahr später durchsuchte",
   "line": 12
  },
  {
   "s": 46.501,
   "e": 48.505,
   "text": "die Polizei Wohnungen in Berlin.",
   "line": 12
  },
  {
   "s": 48.505,
   "e": 50.105,
   "text": "Festgenommen wurden junge Männer",
   "line": 13
  },
  {
   "s": 50.105,
   "e": 52.119,
   "text": "aus einer Berliner Großfamilie.",
   "line": 13
  },
  {
   "s": 52.119,
   "e": 53.479,
   "text": "Einer von ihnen war schon an",
   "line": 14
  },
  {
   "s": 53.479,
   "e": 55.616,
   "text": "einem anderen Coup beteiligt gewesen.",
   "line": 14
  },
  {
   "s": 55.616,
   "e": 57.767,
   "text": "2017 war aus dem Berliner",
   "line": 15
  },
  {
   "s": 57.767,
   "e": 59.499,
   "text": "Bode-Museum eine 100 Kilo",
   "line": 15
  },
  {
   "s": 59.499,
   "e": 61.431,
   "text": "schwere Goldmünze verschwunden.",
   "line": 15
  },
  {
   "s": 61.431,
   "e": 63.671,
   "text": "Im Prozess kam es zu einer Absprache:",
   "line": 16
  },
  {
   "s": 63.671,
   "e": 64.291,
   "text": "Ein großer Teil",
   "line": 16
  },
  {
   "s": 64.291,
   "e": 66.099,
   "text": "der Beute wurde zurückgegeben.",
   "line": 16
  },
  {
   "s": 66.099,
   "e": 68.599,
   "text": "Im Mai 2023 wurden fünf Männer",
   "line": 17
  },
  {
   "s": 68.599,
   "e": 70.259,
   "text": "verurteilt, zu Haftstrafen",
   "line": 17
  },
  {
   "s": 70.259,
   "e": 72.361,
   "text": "zwischen vier und gut sechs Jahren.",
   "line": 17
  },
  {
   "s": 72.361,
   "e": 73.761,
   "text": "Ein sechster Angeklagter wurde",
   "line": 18
  },
  {
   "s": 73.761,
   "e": 75.101,
   "text": "freigesprochen.",
   "line": 18
  },
  {
   "s": 75.101,
   "e": 77.341,
   "text": "2024 bestätigte der",
   "line": 19
  },
  {
   "s": 77.341,
   "e": 79.206,
   "text": "Bundesgerichtshof das Urteil.",
   "line": 19
  },
  {
   "s": 79.206,
   "e": 80.666,
   "text": "Die meisten Juwelen sind heute wieder",
   "line": 20
  },
  {
   "s": 80.666,
   "e": 82.7,
   "text": "im Grünen Gewölbe zu sehen.",
   "line": 20
  },
  {
   "s": 82.7,
   "e": 84.5,
   "text": "Doch nach letzten Berichten fehlen",
   "line": 21
  },
  {
   "s": 84.5,
   "e": 85.58,
   "text": "einige der wertvollsten",
   "line": 21
  },
  {
   "s": 85.58,
   "e": 86.718,
   "text": "Stücke noch immer.",
   "line": 21
  },
  {
   "s": 86.718,
   "e": 88.058,
   "text": "Darunter eine Schulterzier",
   "line": 22
  },
  {
   "s": 88.058,
   "e": 90.396,
   "text": "mit dem Diamanten Sächsischer Weißer.",
   "line": 22
  },
  {
   "s": 90.396,
   "e": 91.714,
   "text": "Wo sind sie? Zerlegt,",
   "line": 23
  },
  {
   "s": 91.714,
   "e": 93.577,
   "text": "verkauft oder irgendwo versteckt?",
   "line": 23
  },
  {
   "s": 93.577,
   "e": 95.17,
   "text": "Was denkst du?",
   "line": 24
  }
 ],
