 "subs": [
  {
   "s": 0.22,
   "e": 1.733,
   "text": "Ein zerbrochenes Fenster,",
   "line": 1
  },
  {
   "s": 1.733,
   "e": 4.303,
   "text": "eine Schale Ananas und fremde DNA.",
   "line": 1
  },
  {
   "s": 4.323,
   "e": 5.775,
   "text": "Das ist Teil zwei im Fall",
   "line": 2
  },
  {
   "s": 5.775,
   "e": 7.43,
   "text": "JonBenét Ramsey.",
   "line": 2
  },
  {
   "s": 7.45,
   "e": 9.69,
   "text": "Im Keller war ein Fenster zerbrochen,",
   "line": 3
  },
  {
   "s": 9.69,
   "e": 11.387,
   "text": "darunter stand ein Koffer.",
   "line": 3
  },
  {
   "s": 11.407,
   "e": 12.707,
   "text": "Kam der Täter hier herein,",
   "line": 4
  },
  {
   "s": 12.707,
   "e": 14.157,
   "text": "oder hinaus?",
   "line": 4
  },
  {
   "s": 14.177,
   "e": 15.917,
   "text": "Doch John sagte, er habe",
   "line": 5
  },
  {
   "s": 15.917,
   "e": 17.917,
   "text": "es früher selbst eingeschlagen,",
   "line": 5
  },
  {
   "s": 17.917,
   "e": 20.043,
   "text": "als er den Schlüssel vergessen hatte.",
   "line": 5
  },
  {
   "s": 20.063,
   "e": 21.52,
   "text": "Ein Einbruch in dieser Nacht",
   "line": 6
  },
  {
   "s": 21.52,
   "e": 23.493,
   "text": "ist damit nicht bewiesen.",
   "line": 6
  },
  {
   "s": 23.513,
   "e": 25.322,
   "text": "Schuhabdrücke und andere Spuren",
   "line": 7
  },
  {
   "s": 25.322,
   "e": 27.48,
   "text": "im Keller führten zu niemandem,",
   "line": 7
  },
  {
   "s": 27.48,
   "e": 29.601,
   "text": "der angeklagt werden konnte.",
   "line": 7
  },
  {
   "s": 29.621,
   "e": 30.401,
   "text": "Dann die Ananas",
   "line": 8
  },
  {
   "s": 30.401,
   "e": 32.417,
   "text": "in einer Schale in der Küche.",
   "line": 8
  },
  {
   "s": 32.437,
   "e": 34.594,
   "text": "Laut den Eltern schlief JonBenét",
   "line": 9
  },
  {
   "s": 34.594,
   "e": 36.156,
   "text": "nach der Feier schon.",
   "line": 9
  },
  {
   "s": 36.176,
   "e": 38.036,
   "text": "Doch in ihrem Dünndarm fand man Reste,",
   "line": 10
  },
  {
   "s": 38.036,
   "e": 40.039,
   "text": "vermutlich Ananas.",
   "line": 10
  },
  {
   "s": 40.059,
   "e": 42.039,
   "text": "Wann sie gegessen hat, und mit wem,",
   "line": 11
  },
  {
   "s": 42.039,
   "e": 43.773,
   "text": "lässt sich nicht sagen.",
   "line": 11
  },
  {
   "s": 43.793,
   "e": 45.853,
   "text": "Und ein Fehler am ersten Tag:",
   "line": 12
  },
  {
   "s": 45.853,
   "e": 46.633,
   "text": "Das Haus wurde",
   "line": 12
  },
  {
   "s": 46.633,
   "e": 48.792,
   "text": "nicht vollständig abgesperrt.",
   "line": 12
  },
  {
   "s": 48.812,
   "e": 51.072,
   "text": "Freunde gingen durch viele Räume,",
   "line": 13
  },
  {
   "s": 51.072,
   "e": 52.232,
   "text": "John trug seine Tochter",
   "line": 13
  },
  {
   "s": 52.232,
   "e": 53.478,
   "text": "aus dem Keller.",
   "line": 13
  },
  {
   "s": 53.498,
   "e": 55.118,
   "text": "Das beweist keine Schuld,",
   "line": 14
  },
  {
   "s": 55.118,
   "e": 56.498,
   "text": "aber die Spuren des Täters",
   "line": 14
  },
  {
   "s": 56.498,
   "e": 58.549,
   "text": "waren kaum noch zu trennen.",
   "line": 14
  },
  {
   "s": 58.569,
   "e": 62.144,
   "text": "1999 stimmte eine Grand Jury dafür,",
   "line": 15
  },
  {
   "s": 62.144,
   "e": 63.939,
   "text": "die Eltern anzuklagen.",
   "line": 15
  },
  {
   "s": 63.959,
   "e": 64.859,
   "text": "Doch Staatsanwalt",
   "line": 16
  },
  {
   "s": 64.859,
   "e": 67.119,
   "text": "Alex Hunter erhob keine Anklage:",
   "line": 16
  },
  {
   "s": 67.119,
   "e": 69.086,
   "text": "Die Beweise reichten nicht.",
   "line": 16
  },
  {
   "s": 69.106,
   "e": 70.146,
   "text": "Niemand aus der Familie",
   "line": 17
  },
  {
   "s": 70.146,
   "e": 71.894,
   "text": "wurde je verurteilt.",
   "line": 17
  },
  {
   "s": 71.914,
   "e": 74.274,
   "text": "2006 wurde in Thailand John",
   "line": 18
  },
  {
   "s": 74.274,
   "e": 76.256,
   "text": "Mark Karr festgenommen.",
   "line": 18
  },
  {
   "s": 76.276,
   "e": 77.436,
   "text": "Er behauptete,",
   "line": 19
  },
  {
   "s": 77.436,
   "e": 79.85,
   "text": "mit JonBenéts Tod zu tun zu haben.",
   "line": 19
  },
  {
   "s": 79.87,
   "e": 81.69,
   "text": "Doch seine DNA passte nicht,",
   "line": 20
  },
  {
   "s": 81.69,
   "e": 84.117,
   "text": "die Anklage wurde fallengelassen.",
   "line": 20
  },
  {
   "s": 84.137,
   "e": 86.721,
   "text": "An JonBenéts Kleidung fand man DNA,",
   "line": 21
  },
  {
   "s": 86.721,
   "e": 88.982,
   "text": "die nicht von der Familie stammt.",
   "line": 21
  },
  {
   "s": 89.002,
   "e": 91.609,
   "text": "2008 erklärte Staatsanwältin Mary",
   "line": 22
  },
  {
   "s": 91.609,
   "e": 92.798,
   "text": "Lacy die Familie",
   "line": 22
  },
  {
   "s": 92.798,
   "e": 94.757,
   "text": "für nicht mehr verdächtig.",
   "line": 22
  },
  {
   "s": 94.777,
   "e": 97.737,
   "text": "Doch 2016 zeigten Experten:",
   "line": 23
  },
  {
   "s": 97.737,
   "e": 99.337,
   "text": "Manche Proben sind Mischungen",
   "line": 23
  },
  {
   "s": 99.337,
   "e": 100.914,
   "text": "mehrerer Menschen.",
   "line": 23
  },
  {
   "s": 100.934,
   "e": 102.354,
   "text": "Fremde DNA muss also",
   "line": 24
  },
  {
   "s": 102.354,
   "e": 104.043,
   "text": "nicht vom Täter stammen.",
   "line": 24
  },
  {
   "s": 104.063,
   "e": 107.463,
   "text": "Im November 2026 prüfte die Polizei",
   "line": 25
  },
  {
   "s": 107.463,
   "e": 110.619,
   "text": "neue DNA-Methoden mit Ahnenforschung.",
   "line": 25
  },
  {
   "s": 110.639,
   "e": 112.719,
   "text": "Doch manche Proben sind winzig,",
   "line": 26
  },
  {
   "s": 112.719,
   "e": 115.258,
   "text": "ein Test könnte sie ganz verbrauchen.",
   "line": 26
  },
  {
   "s": 115.278,
   "e": 117.617,
   "text": "Fast 30 Jahre später weiß man,",
   "line": 27
  },
  {
   "s": 117.617,
   "e": 118.958,
   "text": "wie JonBenét starb,",
   "line": 27
  },
  {
   "s": 118.958,
   "e": 120.776,
   "text": "aber nicht, wer es war.",
   "line": 27
  },
  {
   "s": 120.796,
   "e": 122.82,
   "text": "Was denkst du?",
   "line": 28
  }
 ],
