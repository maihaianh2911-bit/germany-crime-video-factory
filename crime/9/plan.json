 "subs": [
  {
   "s": 0.22,
   "e": 1.42,
   "text": "Ein Erpresser legt Bomben",
   "line": 1
  },
  {
   "s": 1.42,
   "e": 2.92,
   "text": "in Kaufhäusern, und die Polizei",
   "line": 1
  },
  {
   "s": 2.92,
   "e": 4.806,
   "text": "jagt ihn sechs Jahre lang.",
   "line": 1
  },
  {
   "s": 4.806,
   "e": 5.926,
   "text": "Trotzdem feiern ihn",
   "line": 2
  },
  {
   "s": 5.926,
   "e": 7.984,
   "text": "viele Menschen wie einen Volkshelden.",
   "line": 2
  },
  {
   "s": 7.984,
   "e": 9.59,
   "text": "Das ist der Fall Dagobert.",
   "line": 3
  },
  {
   "s": 9.59,
   "e": 12.501,
   "text": "Mai 1988: Im Berliner KaDeWe",
   "line": 4
  },
  {
   "s": 12.501,
   "e": 13.989,
   "text": "explodiert eine Bombe.",
   "line": 4
  },
  {
   "s": 13.989,
   "e": 16.489,
   "text": "Der Erpresser fordert 500.000 Mark.",
   "line": 5
  },
  {
   "s": 16.489,
   "e": 17.929,
   "text": "Das Geld soll aus einer fahrenden",
   "line": 5
  },
  {
   "s": 17.929,
   "e": 19.722,
   "text": "S-Bahn geworfen werden.",
   "line": 5
  },
  {
   "s": 19.722,
   "e": 20.942,
   "text": "Die Übergabe klappt.",
   "line": 6
  },
  {
   "s": 20.942,
   "e": 22.835,
   "text": "Der Täter entkommt mit dem Geld.",
   "line": 6
  },
  {
   "s": 22.835,
   "e": 25.255,
   "text": "1992 meldet er sich wieder,",
   "line": 7
  },
  {
   "s": 25.255,
   "e": 26.741,
   "text": "diesmal bei Karstadt.",
   "line": 7
  },
  {
   "s": 26.741,
   "e": 29.114,
   "text": "Er fordert 1,4 Millionen Mark.",
   "line": 8
  },
  {
   "s": 29.114,
   "e": 30.287,
   "text": "Das Zeichen, dass Karstadt",
   "line": 9
  },
  {
   "s": 30.287,
   "e": 32.804,
   "text": "zahlen will, ist eine Zeitungsanzeige.",
   "line": 9
  },
  {
   "s": 32.804,
   "e": 34.294,
   "text": "Darin steht: „Dagobert grüßt",
   "line": 10
  },
  {
   "s": 34.294,
   "e": 35.34,
   "text": "seine Neffen“.",
   "line": 10
  },
  {
   "s": 35.34,
   "e": 37.589,
   "text": "So bekommt der Erpresser seinen Namen.",
   "line": 11
  },
  {
   "s": 37.589,
   "e": 38.628,
   "text": "Um Druck zu machen,",
   "line": 12
  },
  {
   "s": 38.628,
   "e": 39.949,
   "text": "verübt er mehrere Anschläge",
   "line": 12
  },
  {
   "s": 39.949,
   "e": 41.309,
   "text": "auf Karstadt-Häuser.",
   "line": 12
  },
  {
   "s": 41.309,
   "e": 42.729,
   "text": "Und er erfindet immer neue Tricks",
   "line": 13
  },
  {
   "s": 42.729,
   "e": 44.042,
   "text": "für die Geldübergabe.",
   "line": 13
  },
  {
   "s": 44.042,
   "e": 45.462,
   "text": "Eine Kiste, die mit Magneten",
   "line": 14
  },
  {
   "s": 45.462,
   "e": 46.77,
   "text": "an einem Zug hängt.",
   "line": 14
  },
  {
   "s": 46.77,
   "e": 47.535,
   "text": "Eine selbstgebaute",
   "line": 15
  },
  {
   "s": 47.535,
   "e": 49.644,
   "text": "Lore auf einem stillgelegten Gleis.",
   "line": 15
  },
  {
   "s": 49.644,
   "e": 51.343,
   "text": "Kurz vor ihm entgleist sie.",
   "line": 15
  },
  {
   "s": 51.343,
   "e": 53.263,
   "text": "Einmal ist ihm ein Polizist ganz nah,",
   "line": 16
  },
  {
   "s": 53.263,
   "e": 54.95,
   "text": "dann rutscht der Beamte aus.",
   "line": 16
  },
  {
   "s": 54.95,
   "e": 56.95,
   "text": "Die Zeitungen schreiben: auf Hundekot.",
   "line": 17
  },
  {
   "s": 56.95,
   "e": 58.932,
   "text": "In Wahrheit waren es nasse Blätter.",
   "line": 17
  },
  {
   "s": 58.932,
   "e": 60.38,
   "text": "Die Polizei wird zum Gespött,",
   "line": 18
  },
  {
   "s": 60.38,
   "e": 61.665,
   "text": "Dagobert zum Star.",
   "line": 18
  },
  {
   "s": 61.665,
   "e": 66.051,
   "text": "Doch am 22. April 1994 ist Schluss.",
   "line": 19
  },
  {
   "s": 66.051,
   "e": 67.686,
   "text": "Die Polizei fasst ihn in Berlin,",
   "line": 20
  },
  {
   "s": 67.686,
   "e": 69.059,
   "text": "in einer Telefonzelle.",
   "line": 20
  },
  {
   "s": 69.059,
   "e": 70.783,
   "text": "Dagobert heißt Arno Funke.",
   "line": 21
  },
  {
   "s": 70.783,
   "e": 71.623,
   "text": "Er wird zu neun Jahren",
   "line": 22
  },
  {
   "s": 71.623,
   "e": 72.983,
   "text": "Haft verurteilt.",
   "line": 22
  },
  {
   "s": 72.983,
   "e": 75.474,
   "text": "Im Jahr 2000 kommt er vorzeitig frei.",
   "line": 22
  },
  {
   "s": 75.474,
   "e": 77.262,
   "text": "Heute zeichnet er Cartoons.",
   "line": 23
  },
  {
   "s": 77.262,
   "e": 78.582,
   "text": "Und mit einem der Polizisten,",
   "line": 24
  },
  {
   "s": 78.582,
   "e": 79.521,
   "text": "die ihn jagten,",
   "line": 24
  },
  {
   "s": 79.521,
   "e": 81.198,
   "text": "ist er inzwischen befreundet.",
   "line": 24
  },
  {
   "s": 81.198,
   "e": 82.718,
   "text": "Verbrecher oder Volksheld?",
   "line": 25
  },
  {
   "s": 82.718,
   "e": 84.195,
   "text": "Was denkst du?",
   "line": 25
  }
 ],
