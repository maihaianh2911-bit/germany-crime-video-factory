 ],
 "subs": [
  {
   "s": 0.22,
   "e": 2.14,
   "text": "Ein Bauer findet Fußspuren im Schnee.",
   "line": 1
  },
  {
   "s": 2.14,
   "e": 3.4,
   "text": "Sie führen zu seinem Hof,",
   "line": 1
  },
  {
   "s": 3.4,
   "e": 4.679,
   "text": "aber nicht wieder weg.",
   "line": 1
  },
  {
   "s": 4.679,
   "e": 6.359,
   "text": "Wenige Tage später sind alle",
   "line": 2
  },
  {
   "s": 6.359,
   "e": 8.112,
   "text": "sechs Menschen auf dem Hof tot.",
   "line": 2
  },
  {
   "s": 8.112,
   "e": 9.7,
   "text": "Das ist Hinterkaifeck, Deutschlands",
   "line": 3
  },
  {
   "s": 9.7,
   "e": 11.99,
   "text": "bekanntester ungelöster Mordfall.",
   "line": 3
  },
  {
   "s": 11.99,
   "e": 13.87,
   "text": "Ein einsamer Hof bei Schrobenhausen",
   "line": 4
  },
  {
   "s": 13.87,
   "e": 17.381,
   "text": "in Oberbayern, im Frühjahr 1922.",
   "line": 4
  },
  {
   "s": 17.381,
   "e": 18.641,
   "text": "Hier lebte der Bauer Andreas",
   "line": 5
  },
  {
   "s": 18.641,
   "e": 20.8,
   "text": "Gruber mit seiner Frau Cäzilia.",
   "line": 5
  },
  {
   "s": 20.8,
   "e": 22.372,
   "text": "Dazu ihre verwitwete Tochter Viktoria",
   "line": 6
  },
  {
   "s": 22.372,
   "e": 23.659,
   "text": "und deren zwei Kinder,",
   "line": 6
  },
  {
   "s": 23.659,
   "e": 25.259,
   "text": "Cäzilia und Josef.",
   "line": 6
  },
  {
   "s": 25.259,
   "e": 26.979,
   "text": "Ende März erzählte Andreas Gruber",
   "line": 7
  },
  {
   "s": 26.979,
   "e": 29.024,
   "text": "den Nachbarn von seltsamen Dingen.",
   "line": 7
  },
  {
   "s": 29.024,
   "e": 31.004,
   "text": "Spuren im Schnee, die zum Hof führten,",
   "line": 8
  },
  {
   "s": 31.004,
   "e": 32.175,
   "text": "aber nicht zurück.",
   "line": 8
  },
  {
   "s": 32.175,
   "e": 33.595,
   "text": "Ein Hausschlüssel war verschwunden.",
   "line": 9
  },
  {
   "s": 33.595,
   "e": 35.214,
   "text": "Und auf dem Dachboden hörte",
   "line": 9
  },
  {
   "s": 35.214,
   "e": 36.149,
   "text": "er Schritte.",
   "line": 9
  },
  {
   "s": 36.149,
   "e": 37.065,
   "text": "Die frühere Magd hatte",
   "line": 10
  },
  {
   "s": 37.065,
   "e": 38.653,
   "text": "den Hof Monate zuvor verlassen.",
   "line": 10
  },
  {
   "s": 38.653,
   "e": 40.413,
   "text": "Sie sagte, dort spuke es.",
   "line": 10
  },
  {
   "s": 40.413,
   "e": 44.29,
   "text": "Am 31. März 1922 kam eine neue Magd,",
   "line": 11
  },
  {
   "s": 44.29,
   "e": 45.889,
   "text": "Maria Baumgartner.",
   "line": 11
  },
  {
   "s": 45.889,
   "e": 47.169,
   "text": "Es war ihr erster Tag auf dem Hof.",
   "line": 12
  },
  {
   "s": 47.169,
   "e": 48.513,
   "text": "Und ihr letzter.",
   "line": 12
  },
  {
   "s": 48.513,
   "e": 49.113,
   "text": "In dieser Nacht",
   "line": 13
  },
  {
   "s": 49.113,
   "e": 51.377,
   "text": "wurden alle sechs Menschen getötet.",
   "line": 13
  },
  {
   "s": 51.377,
   "e": 53.097,
   "text": "Als Tatwaffe gilt eine Reuthaue,",
   "line": 14
  },
  {
   "s": 53.097,
   "e": 54.168,
   "text": "eine Art Hacke.",
   "line": 14
  },
  {
   "s": 54.168,
   "e": 55.848,
   "text": "Das Unheimlichste: Der Täter",
   "line": 15
  },
  {
   "s": 55.848,
   "e": 57.746,
   "text": "verschwand offenbar nicht sofort.",
   "line": 15
  },
  {
   "s": 57.746,
   "e": 59.426,
   "text": "In den folgenden Tagen versorgte",
   "line": 16
  },
  {
   "s": 59.426,
   "e": 60.937,
   "text": "jemand weiter das Vieh.",
   "line": 16
  },
  {
   "s": 60.937,
   "e": 62.077,
   "text": "Erst nach vier Tagen fanden",
   "line": 17
  },
  {
   "s": 62.077,
   "e": 63.697,
   "text": "Nachbarn die Toten. Vier lagen",
   "line": 17
  },
  {
   "s": 63.697,
   "e": 65.637,
   "text": "in der Scheune, zwei im Haus.",
   "line": 17
  },
  {
   "s": 65.637,
   "e": 66.677,
   "text": "Dutzende Menschen gerieten",
   "line": 18
  },
  {
   "s": 66.677,
   "e": 68.357,
   "text": "unter Verdacht, doch keinem wurde",
   "line": 18
  },
  {
   "s": 68.357,
   "e": 69.961,
   "text": "die Tat nachgewiesen.",
   "line": 18
  },
  {
   "s": 69.961,
   "e": 71.361,
   "text": "Die Reuthaue tauchte erst ein Jahr",
   "line": 19
  },
  {
   "s": 71.361,
   "e": 73.521,
   "text": "später auf, beim Abriss des Hofes,",
   "line": 19
  },
  {
   "s": 73.521,
   "e": 75.098,
   "text": "versteckt im Dachboden.",
   "line": 19
  },
  {
   "s": 75.098,
   "e": 77.638,
   "text": "1955 wurden die Ermittlungen",
   "line": 20
  },
  {
   "s": 77.638,
   "e": 78.773,
   "text": "eingestellt.",
   "line": 20
  },
  {
   "s": 78.773,
   "e": 81.493,
   "text": "2007 rollten angehende Kriminalbeamte",
   "line": 21
  },
  {
   "s": 81.493,
   "e": 83.231,
   "text": "den Fall noch einmal auf.",
   "line": 21
  },
  {
   "s": 83.231,
   "e": 85.171,
   "text": "Sie glaubten, den Täter zu kennen,",
   "line": 22
  },
  {
   "s": 85.171,
   "e": 86.571,
   "text": "nannten aber keinen Namen,",
   "line": 22
  },
  {
   "s": 86.571,
   "e": 88.392,
   "text": "aus Rücksicht auf die Nachkommen.",
   "line": 22
  },
  {
   "s": 88.392,
   "e": 89.79,
   "text": "Über hundert Jahre später ist",
   "line": 23
  },
  {
   "s": 89.79,
   "e": 92.046,
   "text": "Hinterkaifeck noch immer ungelöst.",
   "line": 23
  },
  {
   "s": 92.046,
   "e": 93.162,
   "text": "Wer war auf dem Dachboden?",
   "line": 24
  },
  {
   "s": 93.162,
   "e": 94.168,
   "text": "Und wer versorgte",
   "line": 24
  },
  {
   "s": 94.168,
   "e": 95.45,
   "text": "nach der Tat das Vieh?",
   "line": 24
  },
  {
   "s": 95.45,
   "e": 97.176,
   "text": "Was denkst du?",
   "line": 25
  }
 ],
