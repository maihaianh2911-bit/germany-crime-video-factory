 ],
 "subs": [
  {
   "s": 0.22,
   "e": 2.404,
   "text": "Ihre DNA fand man an rund 40 Tatorten,",
   "line": 1
  },
  {
   "s": 2.404,
   "e": 3.379,
   "text": "in Deutschland,",
   "line": 1
  },
  {
   "s": 3.379,
   "e": 5.054,
   "text": "Österreich und Frankreich.",
   "line": 1
  },
  {
   "s": 5.054,
   "e": 6.774,
   "text": "Morde, Einbrüche, Diebstähle.",
   "line": 2
  },
  {
   "s": 6.774,
   "e": 8.543,
   "text": "Und niemand wusste, wer sie ist.",
   "line": 2
  },
  {
   "s": 8.543,
   "e": 9.503,
   "text": "Die Ermittler nannten",
   "line": 3
  },
  {
   "s": 9.503,
   "e": 11.266,
   "text": "sie die Frau ohne Gesicht.",
   "line": 3
  },
  {
   "s": 11.266,
   "e": 13.165,
   "text": "Das ist das Phantom von Heilbronn.",
   "line": 4
  },
  {
   "s": 13.165,
   "e": 15.145,
   "text": "1993 tauchte ihre",
   "line": 5
  },
  {
   "s": 15.145,
   "e": 16.848,
   "text": "Spur zum ersten Mal auf.",
   "line": 5
  },
  {
   "s": 16.848,
   "e": 18.435,
   "text": "Danach immer wieder, über Jahre,",
   "line": 6
  },
  {
   "s": 18.435,
   "e": 20.429,
   "text": "an ganz verschiedenen Tatorten.",
   "line": 6
  },
  {
   "s": 20.429,
   "e": 21.67,
   "text": "Die DNA passte zu keiner",
   "line": 7
  },
  {
   "s": 21.67,
   "e": 22.903,
   "text": "bekannten Person.",
   "line": 7
  },
  {
   "s": 22.903,
   "e": 25.983,
   "text": "Dann, am 25. April 2007,",
   "line": 8
  },
  {
   "s": 25.983,
   "e": 27.203,
   "text": "wurde in Heilbronn eine junge",
   "line": 8
  },
  {
   "s": 27.203,
   "e": 28.83,
   "text": "Polizistin erschossen.",
   "line": 8
  },
  {
   "s": 28.83,
   "e": 31.004,
   "text": "Ihr Name war Michèle Kiesewetter.",
   "line": 9
  },
  {
   "s": 31.004,
   "e": 33.237,
   "text": "Ihr Kollege überlebte schwer verletzt.",
   "line": 9
  },
  {
   "s": 33.237,
   "e": 34.075,
   "text": "Am Streifenwagen",
   "line": 10
  },
  {
   "s": 34.075,
   "e": 35.974,
   "text": "fand man wieder dieselbe DNA.",
   "line": 10
  },
  {
   "s": 35.974,
   "e": 37.143,
   "text": "Jetzt suchte ganz Deutschland",
   "line": 11
  },
  {
   "s": 37.143,
   "e": 38.833,
   "text": "nach der unbekannten Frau.",
   "line": 11
  },
  {
   "s": 38.833,
   "e": 41.778,
   "text": "Die Belohnung stieg auf 300.000 Euro.",
   "line": 11
  },
  {
   "s": 41.778,
   "e": 43.577,
   "text": "Wer war diese Frau, die mordet,",
   "line": 12
  },
  {
   "s": 43.577,
   "e": 45.553,
   "text": "einbricht und spurlos verschwindet?",
   "line": 12
  },
  {
   "s": 45.553,
   "e": 46.913,
   "text": "Doch etwas passte nicht:",
   "line": 13
  },
  {
   "s": 46.913,
   "e": 48.672,
   "text": "Die Spur tauchte an Orten auf,",
   "line": 13
  },
  {
   "s": 48.672,
   "e": 50.548,
   "text": "die nichts miteinander zu tun hatten.",
   "line": 13
  },
  {
   "s": 50.548,
   "e": 52.339,
   "text": "2009 kam die Wende.",
   "line": 14
  },
  {
   "s": 52.339,
   "e": 53.179,
   "text": "Die Ermittler prüften",
   "line": 15
  },
  {
   "s": 53.179,
   "e": 54.379,
   "text": "die Wattestäbchen,",
   "line": 15
  },
  {
   "s": 54.379,
   "e": 56.472,
   "text": "mit denen Spuren gesichert wurden.",
   "line": 15
  },
  {
   "s": 56.472,
   "e": 58.232,
   "text": "Die DNA stammte von einer Frau,",
   "line": 16
  },
  {
   "s": 58.232,
   "e": 59.092,
   "text": "die in einer Fabrik solche",
   "line": 16
  },
  {
   "s": 59.092,
   "e": 60.967,
   "text": "Wattestäbchen verpackte.",
   "line": 16
  },
  {
   "s": 60.967,
   "e": 62.416,
   "text": "Die Stäbchen waren steril,",
   "line": 17
  },
  {
   "s": 62.416,
   "e": 64.333,
   "text": "aber nicht frei von menschlicher DNA.",
   "line": 17
  },
  {
   "s": 64.333,
   "e": 66.34,
   "text": "Das Phantom hatte nie existiert.",
   "line": 18
  },
  {
   "s": 66.34,
   "e": 67.6,
   "text": "Jahrelang hatte die Polizei",
   "line": 19
  },
  {
   "s": 67.6,
   "e": 69.24,
   "text": "eine Frau gejagt, die mit keinem",
   "line": 19
  },
  {
   "s": 69.24,
   "e": 71.134,
   "text": "dieser Verbrechen zu tun hatte.",
   "line": 19
  },
  {
   "s": 71.134,
   "e": 73.274,
   "text": "Seitdem gelten für Wattestäbchen in",
   "line": 20
  },
  {
   "s": 73.274,
   "e": 75.456,
   "text": "der Spurensicherung strengere Regeln.",
   "line": 20
  },
  {
   "s": 75.456,
   "e": 77.624,
   "text": "Und der Mord an Michèle Kiesewetter?",
   "line": 21
  },
  {
   "s": 77.624,
   "e": 79.624,
   "text": "2011 stellte sich heraus:",
   "line": 22
  },
  {
   "s": 79.624,
   "e": 80.744,
   "text": "Er gehörte zur Mordserie",
   "line": 22
  },
  {
   "s": 80.744,
   "e": 83.221,
   "text": "der rechtsextremen Terrorgruppe NSU.",
   "line": 22
  },
  {
   "s": 83.221,
   "e": 84.841,
   "text": "Ihre Dienstwaffe fand man im Wohnmobil",
   "line": 23
  },
  {
   "s": 84.841,
   "e": 86.731,
   "text": "von zwei NSU-Mitgliedern.",
   "line": 23
  },
  {
   "s": 86.731,
   "e": 88.251,
   "text": "Eine falsche Spur hatte die Ermittler",
   "line": 24
  },
  {
   "s": 88.251,
   "e": 90.229,
   "text": "jahrelang in die Irre geführt.",
   "line": 24
  },
  {
   "s": 90.229,
   "e": 91.849,
   "text": "Kann man DNA also immer vertrauen?",
   "line": 25
  },
  {
   "s": 91.849,
   "e": 93.41,
   "text": "Was denkst du?",
   "line": 25
  }
 ],
