 "subs": [
  {
   "s": 0.22,
   "e": 1.36,
   "text": "Das ist die wahre Geschichte",
   "line": 1
  },
  {
   "s": 1.36,
   "e": 3.38,
   "text": "hinter dem Film „Der Exorzismus",
   "line": 1
  },
  {
   "s": 3.38,
   "e": 5.057,
   "text": "von Emily Rose“.",
   "line": 1
  },
  {
   "s": 5.077,
   "e": 7.677,
   "text": "1976 starb in Deutschland",
   "line": 2
  },
  {
   "s": 7.677,
   "e": 10.323,
   "text": "eine 23-jährige Frau.",
   "line": 2
  },
  {
   "s": 10.343,
   "e": 11.923,
   "text": "Zuvor hatte sie monatelang",
   "line": 3
  },
  {
   "s": 11.923,
   "e": 13.603,
   "text": "religiöse Rituale erlebt,",
   "line": 3
  },
  {
   "s": 13.603,
   "e": 15.729,
   "text": "in ihrem eigenen Zuhause.",
   "line": 3
  },
  {
   "s": 15.749,
   "e": 17.149,
   "text": "Das Zimmer war klein,",
   "line": 4
  },
  {
   "s": 17.149,
   "e": 18.832,
   "text": "die Stimmung bedrückend.",
   "line": 4
  },
  {
   "s": 18.852,
   "e": 19.812,
   "text": "Die Sitzungen wurden",
   "line": 5
  },
  {
   "s": 19.812,
   "e": 21.933,
   "text": "auf Tonband aufgenommen.",
   "line": 5
  },
  {
   "s": 21.953,
   "e": 23.532,
   "text": "Was darauf zu hören war,",
   "line": 6
  },
  {
   "s": 23.532,
   "e": 26.006,
   "text": "erschütterte später das ganze Land.",
   "line": 6
  },
  {
   "s": 26.026,
   "e": 28.218,
   "text": "Ihr Name war Anneliese Michel.",
   "line": 7
  },
  {
   "s": 28.238,
   "e": 30.178,
   "text": "Als die Exorzismen begannen,",
   "line": 8
  },
  {
   "s": 30.178,
   "e": 31.738,
   "text": "glaubte ihre Familie, etwas",
   "line": 8
  },
  {
   "s": 31.738,
   "e": 34.172,
   "text": "Übernatürliches habe sie ergriffen.",
   "line": 8
  },
  {
   "s": 34.192,
   "e": 36.802,
   "text": "Sie sagte, sie höre ständig Stimmen.",
   "line": 9
  },
  {
   "s": 36.822,
   "e": 38.702,
   "text": "Sie sah verstörende Gesichter",
   "line": 10
  },
  {
   "s": 38.702,
   "e": 40.618,
   "text": "und Schatten um sich herum.",
   "line": 10
  },
  {
   "s": 40.638,
   "e": 41.938,
   "text": "Bei den Ritualen soll",
   "line": 11
  },
  {
   "s": 41.938,
   "e": 44.25,
   "text": "sich ihre Stimme verändert haben.",
   "line": 11
  },
  {
   "s": 44.27,
   "e": 46.33,
   "text": "Die Wesen in sich nannte sie Luzifer,",
   "line": 12
  },
  {
   "s": 46.33,
   "e": 48.724,
   "text": "Judas, Nero, Kain und andere.",
   "line": 12
  },
  {
   "s": 48.744,
   "e": 51.164,
   "text": "Die beteiligten Priester sahen darin",
   "line": 13
  },
  {
   "s": 51.164,
   "e": 53.691,
   "text": "Zeichen dämonischer Besessenheit.",
   "line": 13
  },
  {
   "s": 53.711,
   "e": 54.351,
   "text": "Doch schon Jahre",
   "line": 14
  },
  {
   "s": 54.351,
   "e": 56.151,
   "text": "zuvor hatten Ärzte bei ihr",
   "line": 14
  },
  {
   "s": 56.151,
   "e": 59.266,
   "text": "Schläfenlappen-Epilepsie festgestellt.",
   "line": 14
  },
  {
   "s": 59.286,
   "e": 61.724,
   "text": "Dazu kam eine schwere Depression.",
   "line": 15
  },
  {
   "s": 61.744,
   "e": 63.584,
   "text": "Sie war in ärztlicher Behandlung",
   "line": 16
  },
  {
   "s": 63.584,
   "e": 65.084,
   "text": "und nahm Medikamente,",
   "line": 16
  },
  {
   "s": 65.084,
   "e": 67.061,
   "text": "doch die Symptome blieben.",
   "line": 16
  },
  {
   "s": 67.081,
   "e": 68.761,
   "text": "Als es ihr schlechter ging,",
   "line": 17
  },
  {
   "s": 68.761,
   "e": 69.801,
   "text": "setzte die Familie",
   "line": 17
  },
  {
   "s": 69.801,
   "e": 71.749,
   "text": "immer mehr auf die Kirche.",
   "line": 17
  },
  {
   "s": 71.769,
   "e": 76.489,
   "text": "Zwischen 1975 und 1976 wurden",
   "line": 18
  },
  {
   "s": 76.489,
   "e": 78.469,
   "text": "über 60 Exorzismen",
   "line": 18
  },
  {
   "s": 78.469,
   "e": 81.356,
   "text": "offiziell genehmigt und durchgeführt.",
   "line": 18
  },
  {
   "s": 81.376,
   "e": 82.636,
   "text": "Ihr Körper verfiel.",
   "line": 19
  },
  {
   "s": 82.636,
   "e": 84.193,
   "text": "Sie aß immer weniger.",
   "line": 19
  },
  {
   "s": 84.213,
   "e": 85.447,
   "text": "Im Sommer 1976",
   "line": 20
  },
  {
   "s": 85.447,
   "e": 88.751,
   "text": "war sie schwer unterernährt.",
   "line": 20
  },
  {
   "s": 88.771,
   "e": 91.591,
   "text": "Im Juli 1976 starb",
   "line": 21
  },
  {
   "s": 91.591,
   "e": 93.81,
   "text": "Anneliese Michel an Unterernährung",
   "line": 21
  },
  {
   "s": 93.81,
   "e": 95.638,
   "text": "und Flüssigkeitsmangel.",
   "line": 21
  },
  {
   "s": 95.658,
   "e": 98.347,
   "text": "Sie wurde nur 23 Jahre alt.",
   "line": 22
  },
  {
   "s": 98.367,
   "e": 100.027,
   "text": "Nach ihrem Tod beschäftigte",
   "line": 23
  },
  {
   "s": 100.027,
   "e": 101.705,
   "text": "der Fall die Justiz.",
   "line": 23
  },
  {
   "s": 101.725,
   "e": 103.185,
   "text": "Ihre Eltern und die beiden",
   "line": 24
  },
  {
   "s": 103.185,
   "e": 104.925,
   "text": "Priester wurden wegen fahrlässiger",
   "line": 24
  },
  {
   "s": 104.925,
   "e": 106.628,
   "text": "Tötung angeklagt.",
   "line": 24
  },
  {
   "s": 106.648,
   "e": 109.068,
   "text": "Die Anklage sagte: Mit ärztlicher",
   "line": 25
  },
  {
   "s": 109.068,
   "e": 111.365,
   "text": "Behandlung hätte sie überleben können.",
   "line": 25
  },
  {
   "s": 111.385,
   "e": 113.085,
   "text": "Die Verteidigung erklärte,",
   "line": 26
  },
  {
   "s": 113.085,
   "e": 114.425,
   "text": "sie hätten an eine echte",
   "line": 26
  },
  {
   "s": 114.425,
   "e": 116.831,
   "text": "geistliche Notlage geglaubt.",
   "line": 26
  },
  {
   "s": 116.851,
   "e": 119.487,
   "text": "Das Gericht sprach alle vier schuldig.",
   "line": 27
  },
  {
   "s": 119.507,
   "e": 121.227,
   "text": "Ärztliche Hilfe sei verfügbar",
   "line": 28
  },
  {
   "s": 121.227,
   "e": 123.168,
   "text": "und notwendig gewesen.",
   "line": 28
  },
  {
   "s": 123.188,
   "e": 124.808,
   "text": "Der Fall löste eine bundesweite",
   "line": 29
  },
  {
   "s": 124.808,
   "e": 126.228,
   "text": "Debatte aus und wird",
   "line": 29
  },
  {
   "s": 126.228,
   "e": 128.442,
   "text": "bis heute diskutiert.",
   "line": 29
  }
 ],
