 "subs": [
  {
   "s": 0.22,
   "e": 1.24,
   "text": "Eine Familie bekam",
   "line": 1
  },
  {
   "s": 1.24,
   "e": 2.36,
   "text": "einen Erpresserbrief",
   "line": 1
  },
  {
   "s": 2.36,
   "e": 4.856,
   "text": "über 118.000 Dollar.",
   "line": 1
  },
  {
   "s": 4.876,
   "e": 6.916,
   "text": "Doch knapp acht Stunden später lag",
   "line": 2
  },
  {
   "s": 6.916,
   "e": 8.236,
   "text": "das Kind tot im Keller",
   "line": 2
  },
  {
   "s": 8.236,
   "e": 9.878,
   "text": "des eigenen Hauses.",
   "line": 2
  },
  {
   "s": 9.898,
   "e": 12.378,
   "text": "Der Brief war fast drei Seiten lang,",
   "line": 3
  },
  {
   "s": 12.378,
   "e": 13.478,
   "text": "geschrieben mit Papier",
   "line": 3
  },
  {
   "s": 13.478,
   "e": 15.284,
   "text": "und Stift aus dem Haus.",
   "line": 3
  },
  {
   "s": 15.304,
   "e": 16.927,
   "text": "Wer hat ihn geschrieben?",
   "line": 4
  },
  {
   "s": 16.947,
   "e": 18.427,
   "text": "Und warum schreibt ein Entführer",
   "line": 5
  },
  {
   "s": 18.427,
   "e": 19.967,
   "text": "am Tatort, wenn das Opfer",
   "line": 5
  },
  {
   "s": 19.967,
   "e": 22.119,
   "text": "das Haus nie verlassen hat?",
   "line": 5
  },
  {
   "s": 22.139,
   "e": 24.393,
   "text": "Das ist der Fall JonBenét Ramsey,",
   "line": 6
  },
  {
   "s": 24.393,
   "e": 25.262,
   "text": "einer der bekanntesten",
   "line": 6
  },
  {
   "s": 25.262,
   "e": 27.554,
   "text": "ungelösten Fälle der USA.",
   "line": 6
  },
  {
   "s": 27.574,
   "e": 32.28,
   "text": "Weihnachten 1996 in Boulder, Colorado.",
   "line": 7
  },
  {
   "s": 32.3,
   "e": 33.107,
   "text": "Die sechsjährige",
   "line": 8
  },
  {
   "s": 33.107,
   "e": 35.608,
   "text": "JonBenét lebte mit Vater John,",
   "line": 8
  },
  {
   "s": 35.608,
   "e": 37.986,
   "text": "Mutter Patsy und Bruder Burke.",
   "line": 8
  },
  {
   "s": 38.006,
   "e": 40.026,
   "text": "Laut den Eltern schlief sie schon,",
   "line": 9
  },
  {
   "s": 40.026,
   "e": 41.146,
   "text": "als sie nach einer Feier",
   "line": 9
  },
  {
   "s": 41.146,
   "e": 44.229,
   "text": "am 25. Dezember ins Bett kam.",
   "line": 9
  },
  {
   "s": 44.249,
   "e": 45.588,
   "text": "Gegen 5:30 Uhr",
   "line": 10
  },
  {
   "s": 45.588,
   "e": 47.269,
   "text": "fand Patsy an der Treppe",
   "line": 10
  },
  {
   "s": 47.269,
   "e": 49.624,
   "text": "einen handgeschriebenen Brief.",
   "line": 10
  },
  {
   "s": 49.644,
   "e": 51.584,
   "text": "Eine angebliche ausländische Gruppe",
   "line": 11
  },
  {
   "s": 51.584,
   "e": 54.244,
   "text": "forderte genau 118.000 Dollar,",
   "line": 11
  },
  {
   "s": 54.244,
   "e": 56.432,
   "text": "und keine Polizei.",
   "line": 11
  },
  {
   "s": 56.452,
   "e": 58.933,
   "text": "Doch um 5:52 Uhr rief Patsy",
   "line": 12
  },
  {
   "s": 58.933,
   "e": 60.097,
   "text": "den Notruf.",
   "line": 12
  },
  {
   "s": 60.117,
   "e": 62.437,
   "text": "Die Polizei fand keine klare Spur,",
   "line": 13
  },
  {
   "s": 62.437,
   "e": 63.577,
   "text": "dass jemand JonBenét",
   "line": 13
  },
  {
   "s": 63.577,
   "e": 65.474,
   "text": "aus dem Haus gebracht hatte.",
   "line": 13
  },
  {
   "s": 65.494,
   "e": 68.034,
   "text": "Um 13:05 Uhr sollte John das Haus",
   "line": 14
  },
  {
   "s": 68.034,
   "e": 69.702,
   "text": "noch einmal durchsuchen.",
   "line": 14
  },
  {
   "s": 69.722,
   "e": 71.562,
   "text": "Im Keller öffnete er den Weinkeller",
   "line": 15
  },
  {
   "s": 71.562,
   "e": 73.53,
   "text": "und fand seine Tochter.",
   "line": 15
  },
  {
   "s": 73.55,
   "e": 75.31,
   "text": "Sie wurde erdrosselt und hatte",
   "line": 16
  },
  {
   "s": 75.31,
   "e": 77.401,
   "text": "eine schwere Kopfverletzung.",
   "line": 16
  },
  {
   "s": 77.421,
   "e": 78.301,
   "text": "Die Schlinge:",
   "line": 17
  },
  {
   "s": 78.301,
   "e": 80.241,
   "text": "eine Schnur und ein abgebrochener",
   "line": 17
  },
  {
   "s": 80.241,
   "e": 83.255,
   "text": "Pinselstiel aus den Malsachen im Haus.",
   "line": 17
  },
  {
   "s": 83.275,
   "e": 85.175,
   "text": "Ein Brief aus dem Haus, eine Schlinge",
   "line": 18
  },
  {
   "s": 85.175,
   "e": 87.791,
   "text": "aus dem Haus, und das Opfer im Keller.",
   "line": 18
  },
  {
   "s": 87.811,
   "e": 89.107,
   "text": "Die erste Spur: der Brief.",
   "line": 19
  },
  {
   "s": 89.107,
   "e": 92.219,
   "text": "Zweieinhalb Seiten, voller Drohungen.",
   "line": 19
  },
  {
   "s": 92.239,
   "e": 94.779,
   "text": "Warum genau 118.000 Dollar?",
   "line": 20
  },
  {
   "s": 94.779,
   "e": 97.066,
   "text": "Fast so viel wie Johns Bonus.",
   "line": 20
  },
  {
   "s": 97.086,
   "e": 98.186,
   "text": "Kannte der Verfasser",
   "line": 21
  },
  {
   "s": 98.186,
   "e": 100.023,
   "text": "die Finanzen der Familie?",
   "line": 21
  },
  {
   "s": 100.043,
   "e": 101.983,
   "text": "Block und Stift stammten aus dem Haus,",
   "line": 22
  },
  {
   "s": 101.983,
   "e": 104.507,
   "text": "dazu Spuren eines Entwurfs.",
   "line": 22
  },
  {
   "s": 104.527,
   "e": 106.127,
   "text": "Warum schreibt eine Profi-Bande",
   "line": 23
  },
  {
   "s": 106.127,
   "e": 108.972,
   "text": "ihren Brief erst im Haus des Opfers?",
   "line": 23
  },
  {
   "s": 108.992,
   "e": 110.479,
   "text": "Die Schrift? John wurde",
   "line": 24
  },
  {
   "s": 110.479,
   "e": 112.72,
   "text": "ausgeschlossen, Patsy nicht ganz.",
   "line": 24
  },
  {
   "s": 112.74,
   "e": 114.34,
   "text": "Doch das beweist nicht,",
   "line": 25
  },
  {
   "s": 114.34,
   "e": 115.786,
   "text": "dass sie ihn schrieb.",
   "line": 25
  },
  {
   "s": 115.806,
   "e": 116.644,
   "text": "Und im Keller wartete",
   "line": 26
  },
  {
   "s": 116.644,
   "e": 120.129,
   "text": "die nächste Spur. Teil zwei folgt.",
   "line": 26
  }
 ],
