 "subs": [
  {
   "s": 0.22,
   "e": 2.1,
   "text": "Wusstest du? Bei einem Mord",
   "line": 1
  },
  {
   "s": 2.1,
   "e": 3.28,
   "text": "ließ der Täter fast alles",
   "line": 1
  },
  {
   "s": 3.28,
   "e": 4.883,
   "text": "am Tatort zurück.",
   "line": 1
  },
  {
   "s": 4.903,
   "e": 7.298,
   "text": "Blut, DNA, Fingerabdrücke, Kleidung,",
   "line": 2
  },
  {
   "s": 7.298,
   "e": 9.825,
   "text": "Schuhspuren und sogar die Tatwaffe.",
   "line": 2
  },
  {
   "s": 9.845,
   "e": 11.885,
   "text": "Doch nach über 25 Jahren weiß",
   "line": 3
  },
  {
   "s": 11.885,
   "e": 14.085,
   "text": "die Polizei nicht, wer er ist.",
   "line": 3
  },
  {
   "s": 14.105,
   "e": 15.585,
   "text": "Der Fall Miyazawa,",
   "line": 4
  },
  {
   "s": 15.585,
   "e": 16.625,
   "text": "einer der bekanntesten",
   "line": 4
  },
  {
   "s": 16.625,
   "e": 18.77,
   "text": "ungelösten Fälle Japans.",
   "line": 4
  },
  {
   "s": 18.79,
   "e": 21.15,
   "text": "In der Nacht zum 31. Dezember",
   "line": 5
  },
  {
   "s": 21.15,
   "e": 23.45,
   "text": "2000 wurden in Tokio vier",
   "line": 5
  },
  {
   "s": 23.45,
   "e": 25.921,
   "text": "Menschen in ihrem Haus getötet.",
   "line": 5
  },
  {
   "s": 25.941,
   "e": 27.597,
   "text": "Mikio Miyazawa, 44,",
   "line": 6
  },
  {
   "s": 27.597,
   "e": 29.183,
   "text": "seine Frau Yasuko, 41,",
   "line": 6
  },
  {
   "s": 29.183,
   "e": 33.025,
   "text": "und die Kinder Niina, 8, und Rei, 6.",
   "line": 6
  },
  {
   "s": 33.045,
   "e": 35.385,
   "text": "Rätselhaft ist: Der Täter hinterließ",
   "line": 7
  },
  {
   "s": 35.385,
   "e": 37.557,
   "text": "seine biologische Identität.",
   "line": 7
  },
  {
   "s": 37.577,
   "e": 39.456,
   "text": "Er verletzte sich an der Hand.",
   "line": 8
  },
  {
   "s": 39.456,
   "e": 41.017,
   "text": "Blutgruppe A, seine DNA",
   "line": 8
  },
  {
   "s": 41.017,
   "e": 42.271,
   "text": "wurde gesichert.",
   "line": 8
  },
  {
   "s": 42.291,
   "e": 44.129,
   "text": "Fingerabdrücke und eine einzige",
   "line": 9
  },
  {
   "s": 44.129,
   "e": 46.895,
   "text": "Schuhspur: Es war wohl nur ein Täter.",
   "line": 9
  },
  {
   "s": 46.915,
   "e": 49.295,
   "text": "Dazu Sweatshirt, Mütze, Schal,",
   "line": 10
  },
  {
   "s": 49.295,
   "e": 51.246,
   "text": "Gürteltasche und Taschentücher.",
   "line": 10
  },
  {
   "s": 51.266,
   "e": 53.266,
   "text": "Das Sweatshirt wurde in ganz Japan",
   "line": 11
  },
  {
   "s": 53.266,
   "e": 55.884,
   "text": "nur 130-mal verkauft.",
   "line": 11
  },
  {
   "s": 55.904,
   "e": 58.964,
   "text": "Bis Ende 2025 fand die Polizei",
   "line": 12
  },
  {
   "s": 58.964,
   "e": 60.646,
   "text": "nur zwölf Käufer.",
   "line": 12
  },
  {
   "s": 60.666,
   "e": 62.186,
   "text": "Die Schuhe: Slazenger",
   "line": 13
  },
  {
   "s": 62.186,
   "e": 65.466,
   "text": "aus Südkorea, Größe 27,5,",
   "line": 13
  },
  {
   "s": 65.466,
   "e": 67.522,
   "text": "in Japan damals nicht im Handel.",
   "line": 13
  },
  {
   "s": 67.542,
   "e": 69.802,
   "text": "Die Tatwaffe, ein Sashimi-Messer,",
   "line": 14
  },
  {
   "s": 69.802,
   "e": 71.617,
   "text": "blieb ebenfalls zurück.",
   "line": 14
  },
  {
   "s": 71.637,
   "e": 72.357,
   "text": "Ein Mann,",
   "line": 15
  },
  {
   "s": 72.357,
   "e": 74.017,
   "text": "der so ein Messer gekauft hatte,",
   "line": 15
  },
  {
   "s": 74.017,
   "e": 75.334,
   "text": "wurde gefunden.",
   "line": 15
  },
  {
   "s": 75.354,
   "e": 77.504,
   "text": "Doch seine DNA passte nicht.",
   "line": 16
  },
  {
   "s": 77.524,
   "e": 79.76,
   "text": "Dann das verstörendste Detail.",
   "line": 17
  },
  {
   "s": 79.78,
   "e": 81.5,
   "text": "Der Täter floh nicht sofort.",
   "line": 18
  },
  {
   "s": 81.5,
   "e": 82.93,
   "text": "Er blieb im Haus.",
   "line": 18
  },
  {
   "s": 82.95,
   "e": 84.93,
   "text": "Er aß, ging auf die Toilette,",
   "line": 19
  },
  {
   "s": 84.93,
   "e": 86.33,
   "text": "sah Papiere durch und nutzte",
   "line": 19
  },
  {
   "s": 86.33,
   "e": 87.56,
   "text": "den Computer.",
   "line": 19
  },
  {
   "s": 87.58,
   "e": 89.74,
   "text": "Der Computer war um 1:18 Uhr online",
   "line": 20
  },
  {
   "s": 89.74,
   "e": 92.053,
   "text": "und gegen 10 Uhr erneut.",
   "line": 20
  },
  {
   "s": 92.073,
   "e": 93.513,
   "text": "Ob er bis zum Morgen blieb,",
   "line": 21
  },
  {
   "s": 93.513,
   "e": 95.11,
   "text": "ist aber unsicher.",
   "line": 21
  },
  {
   "s": 95.13,
   "e": 97.69,
   "text": "Die Polizei hat sein Blut, seine DNA,",
   "line": 22
  },
  {
   "s": 97.69,
   "e": 100.055,
   "text": "seine Fingerabdrücke, seine Kleidung.",
   "line": 22
  },
  {
   "s": 100.075,
   "e": 101.855,
   "text": "Sogar kurz geschnittene Haare",
   "line": 23
  },
  {
   "s": 101.855,
   "e": 103.696,
   "text": "aus seiner Gürteltasche.",
   "line": 23
  },
  {
   "s": 103.716,
   "e": 105.225,
   "text": "Nur keinen Namen.",
   "line": 24
  },
  {
   "s": 105.245,
   "e": 108.365,
   "text": "2025 berichteten japanische Medien",
   "line": 25
  },
  {
   "s": 108.365,
   "e": 110.989,
   "text": "über eine neue DNA-Analyse.",
   "line": 25
  },
  {
   "s": 111.009,
   "e": 113.208,
   "text": "Demnach war er damals etwa 30,",
   "line": 26
  },
  {
   "s": 113.208,
   "e": 115.719,
   "text": "heute 50 bis 60 Jahre alt.",
   "line": 26
  },
  {
   "s": 115.739,
   "e": 117.219,
   "text": "Ein Pressebericht, keine von",
   "line": 27
  },
  {
   "s": 117.219,
   "e": 120.053,
   "text": "der Polizei bestätigte Identität.",
   "line": 27
  },
  {
   "s": 120.073,
   "e": 121.033,
   "text": "Ein Vierteljahrhundert",
   "line": 28
  },
  {
   "s": 121.033,
   "e": 123.587,
   "text": "später ist der Fall ungelöst.",
   "line": 28
  },
  {
   "s": 123.607,
   "e": 124.767,
   "text": "Das Unheimlichste:",
   "line": 29
  },
  {
   "s": 124.767,
   "e": 127.01,
   "text": "Er verschwand nicht spurlos.",
   "line": 29
  },
  {
   "s": 127.03,
   "e": 128.15,
   "text": "Er hinterließ fast alles,",
   "line": 30
  },
  {
   "s": 128.15,
   "e": 130.457,
   "text": "außer seinem Namen.",
   "line": 30
  }
 ],
